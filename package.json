{
  "name": "twitch-ad-solutions-tests",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "benchmark": "node tests/benchmark.js",
    "test": "node tests/test.js && node --test tests/*.test.js",
    "test:browser": "playwright test --config tests/playwright.config.js",
    "test:project": "node --test tests/project.test.js",
    "test:package": "node tests/package.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "acorn": "8.19.0",
    "eslint": "10.12.0",
    "globals": "17.13.0"
  }
}
