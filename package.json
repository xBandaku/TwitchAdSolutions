{
  "name": "twitch-ad-solutions-tests",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "benchmark": "node tests/benchmark.js",
    "test": "npm run test:captured && npm run test:resilience && node --test --test-skip-pattern=\"captured response:|synthetic resilience:\" tests/*.test.js",
    "test:captured": "node --test tests/captured.test.js",
    "test:resilience": "node tests/test.js && node --test --test-name-pattern=\"synthetic resilience:\" tests/*.test.js",
    "test:regression": "node tests/regression.js",
    "capture:playlist": "node tests/capture.js",
    "test:browser": "playwright test --config tests/playwright.config.js",
    "test:project": "node --test tests/project.test.js",
    "test:package": "node tests/package.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "acorn": "8.19.0",
    "eslint": "10.12.0",
    "globals": "17.13.0"
  }
}
